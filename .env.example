# ==============================================
# AutoExpert AI - Variables de Entorno (Docker / Local)
# ==============================================

APP_ENV=development
DEBUG=true

# Base de datos PostgreSQL (Docker Compose)
POSTGRES_DB=autoexpert_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin1234
POSTGRES_PORT=5432

# OpenRouter API (Requerido para el Agente LLM)
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Seguridad JWT
JWT_SECRET=autoexpert-dev-secret-change-in-production-2026

# Configuración CORS y Frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
VITE_API_URL=http://localhost:8000
