# AutoExpert AI - Backend Environment Variables
APP_ENV=development
DEBUG=true

# PostgreSQL (dejar en blanco para usar SQLite automáticamente en local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=autoexpert_db

# OpenRouter API
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# JWT Secret
JWT_SECRET=autoexpert-dev-secret-change-in-production-2026
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
